{
  "_comment": "Copy these hook entries into your project's .claude/settings.json (or your user-global ~/.claude/settings.json). Replace AGENT_MEM_SRC with the absolute path to the agent-mem/src checkout. The `--directory` flag tells uv to use the agent-mem project even when the user is working in a totally different repo. Six events are wired: SessionStart, UserPromptSubmit, PostToolUse, Stop, PreCompact, SessionEnd. The first three new ones (PostToolUse, Stop, UserPromptSubmit) only stream events to the daemon — they do NOT call the Agent SDK. SessionStart, PreCompact, and SessionEnd do BOTH (event stream + their pre-existing knowledge-compiler behavior).",
  "_example_path": "/Users/you/code/agent-mem/src",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory AGENT_MEM_SRC python AGENT_MEM_SRC/hooks/session-start.py",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory AGENT_MEM_SRC python AGENT_MEM_SRC/hooks/user-prompt-submit.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory AGENT_MEM_SRC python AGENT_MEM_SRC/hooks/post-tool-use.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory AGENT_MEM_SRC python AGENT_MEM_SRC/hooks/stop.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory AGENT_MEM_SRC python AGENT_MEM_SRC/hooks/pre-compact.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory AGENT_MEM_SRC python AGENT_MEM_SRC/hooks/session-end.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
